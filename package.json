{
  "name": "@atom-forge/bookmd",
  "version": "0.1.3",
  "description": "Static course portals from Markdown: local and Git-hosted courses, local browser preview and change-based publishing.",
  "license": "MIT",
  "author": "Gergely Laborci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atom-forge/bookmd.git"
  },
  "homepage": "https://github.com/atom-forge/bookmd#readme",
  "bugs": {
    "url": "https://github.com/atom-forge/bookmd/issues"
  },
  "keywords": [
    "markdown",
    "courses",
    "documentation",
    "static-site",
    "sveltekit",
    "bun"
  ],
  "type": "module",
  "bin": {
    "bookmd": "./cli.ts"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.12.0"
  },
  "files": [
    "cli.ts",
    "src",
    "scripts",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/*.test.ts"
  ],
  "exports": {
    "./core": "./src/core/content.ts"
  },
  "scripts": {
    "test": "bun test src scripts",
    "check": "bun cli.ts check --config examples/minimal/portal.config.ts",
    "build:example": "bun cli.ts build --config examples/minimal/portal.config.ts",
    "verify": "bun run test && bun run check && bun run build:example",
    "pub": "ship-it",
    "pub-check": "ship-it check",
    "pub-validate": "ship-it validate"
  },
  "dependencies": {
    "@atom-forge/ui": "^0.0.37",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "lucide-svelte": "^1.0.1",
    "mermaid": "^11.17.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "mdast-util-to-string": "^4.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^7.3.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@atom-forge/ship": "0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "ship": {
    "verify": [
      "bun run check",
      "bun run test"
    ]
  }
}
